[
  {"id":"01","group":"基础","prompt":"测量当前声音时长","steps":[{"tool":"duration","args":{}}],"markers":["秒"]},
  {"id":"02","group":"基础","prompt":"查询对象 {sound} 的时长、采样率和声道数。","steps":[{"tool":"object_info","args":{}}],"markers":["采样"]},
  {"id":"03","group":"快速测量","prompt":"测量当前声音平均基频","steps":[{"tool":"pitch_statistics","args":{}}],"markers":["Hz"]},
  {"id":"04","group":"快速测量","prompt":"测量当前声音平均强度","steps":[{"tool":"intensity_statistics","args":{}}],"markers":["dB"]},
  {"id":"05","group":"多时间点","prompt":"测量对象 {sound} 在 0.25 秒和 0.75 秒的基频。","steps":[{"tool":"pitch","args":{"time":"0.25,0.75"}}],"markers":["0.250","0.750"]},
  {"id":"06","group":"明确范围","prompt":"只统计对象 {sound} 的 0.1–0.4 秒基频，不要统计整段。","steps":[{"tool":"pitch_statistics","args":{"from":0.1,"to":0.4}}],"markers":["0.100","0.400"]},
  {"id":"07","group":"共振峰","prompt":"测量对象 {sound} 在 0.3 秒的 F1 和 F2，单位 Hz。","steps":[{"tool":"formant_frequency","args":{"time":0.3,"formant":"1,2"}}],"markers":["第 1","第 2"]},
  {"id":"08","group":"共振峰","prompt":"测量对象 {sound} 在 0.3 秒的第一、第二共振峰带宽。","steps":[{"tool":"formant_bandwidth","args":{"time":0.3,"formant":"1,2"}}],"markers":["带宽"]},
  {"id":"09","group":"共振峰","prompt":"统计对象 {sound} 的 0.1–0.4 秒 F1、F2 平均值和标准差。","steps":[{"tool":"formant_statistics","args":{"from":0.1,"to":0.4,"formant":"1,2"}}],"markers":["平均"]},
  {"id":"10","group":"强度","prompt":"测量对象 {sound} 在 0.3 秒的强度。","steps":[{"tool":"intensity","args":{"time":0.3}}],"markers":["dB"]},
  {"id":"11","group":"明确范围","prompt":"统计对象 {sound} 的 0.1–0.4 秒平均和最高强度。","steps":[{"tool":"intensity_statistics","args":{"from":0.1,"to":0.4}}],"markers":["0.100","0.400"]},
  {"id":"12","group":"嗓音","prompt":"测量对象 {sound} 的谐噪比 HNR。","steps":[{"tool":"harmonicity_statistics","args":{}}],"markers":["dB"]},
  {"id":"13","group":"频谱","prompt":"测量对象 {sound} 的频谱重心、偏度和峰度。","steps":[{"tool":"measure","args":{"parameter":"centre_of_gravity,skewness,kurtosis"}}]},
  {"id":"14","group":"嗓音","prompt":"测量对象 {sound} 的 local jitter。","steps":[{"tool":"measure","args":{"parameter":"local_jitter"}}]},
  {"id":"15","group":"嗓音","prompt":"测量对象 {sound} 的 local shimmer，使用百分比。","steps":[{"tool":"measure","args":{"parameter":"local_shimmer_percent"}}]},
  {"id":"16","group":"嗓音","prompt":"测量对象 {sound} 的 CPPS。","steps":[{"tool":"measure","args":{"parameter":"cpps"}}]},
  {"id":"17","group":"VOT","prompt":"对象 {sound} 的爆破在 0.20 秒，浊音起始在 0.23 秒，请计算 VOT。","steps":[{"tool":"vot","args":{"burst":0.2,"voicing":0.23}}],"markers":["30.0"]},
  {"id":"18","group":"VOT","prompt":"在对象 {sound} 的 0.1–0.4 秒范围内自动估计 VOT，并说明不确定性，不要猜爆破时刻。","steps":[{"tool":"vot","args":{"from":0.1,"to":0.4}}],"allow_unavailable":true},
  {"id":"19","group":"频谱","prompt":"测量对象 {sound} 的 spectral emphasis。","steps":[{"tool":"spectral_emphasis","args":{}}]},
  {"id":"20","group":"韵律","prompt":"计算对象 {sound} 的整体强度斜率，单位 dB/s。","steps":[{"tool":"intensity_slope","args":{"method":"global"}}]},
  {"id":"21","group":"选区","prompt":"测量当前声音平均基频","selection":[0.2,0.5],"steps":[{"tool":"pitch_statistics","args":{}}],"markers":["0.200","0.500"]},
  {"id":"22","group":"不存在的对象","prompt":"测量对象 999999 的基频；找不到就说明，不要改用别的对象。","steps":[{"tool":"pitch_statistics","args":{"object":999999}}],"expect":"rejected"},
  {"id":"23","group":"派生对象类型","prompt":"对 Harmonicity 对象 {derived} 执行 To Pitch，不要换成 Sound。","fixture":"derived","steps":[{"tool":"pitch_statistics","args":{"object":2}}],"expect":"rejected"},
  {"id":"24","group":"静音","prompt":"测量静音对象 {sound} 的平均基频；无法计算就明确说明，不要给出虚构数值。","fixture":"silence","steps":[{"tool":"pitch_statistics","args":{}}],"allow_unavailable":true,"unavailable_required":true},
  {"id":"25","group":"组合测量","prompt":"对对象 {sound} 分别测量整段时长、基频统计和强度统计，保留三个测量结果。","steps":[{"tool":"duration","args":{}},{"tool":"pitch_statistics","args":{}},{"tool":"intensity_statistics","args":{}}],"markers":["秒","Hz","dB"]},
  {"id":"26","group":"一般讨论","prompt":"请解释 F0 和 F1、F2 的区别。这是一般知识问题，不需要测量我的录音。","model_only":true,"expect":"discussion"},
  {"id":"27","group":"发音证据边界","prompt":"分析对象 {sound} 整段录音的发音不足；没有标准录音和可靠转写时，请区分实测事实、一般建议和无法判断的部分。","model_only":true,"expect":"review"},
  {"id":"28","group":"多轮证据复用","prompt":"本次解释结果","model_only":true,"followup":"25","expect":"reuse"}
