    "unified": "^11.0.0",
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/use-sync-external-store": "^0.0.6",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
