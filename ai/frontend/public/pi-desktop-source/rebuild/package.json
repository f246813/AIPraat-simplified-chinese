{
  "name": "praat-assistant-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "predev": "node scripts/offline-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/offline-assets.mjs && node scripts/license-notices.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@tanstack/react-virtual": "3.14.22",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.6.6",
    "@tiptap/starter-kit": "3.6.6",
    "dompurify": "3.2.7",
    "highlight.js": "11.11.1",
    "katex": "0.16.22",
    "lucide-react": "0.468.0",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.12.0",
    "prosemirror-markdown": "1.13.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
